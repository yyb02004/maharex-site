# Copy to .env on the NAS. Never put this file's real secrets in Git or Vercel.
ALLOWED_ORIGINS=https://maharex.com,https://www.maharex.com
# Optional administrator delete token: generate at least 32 random characters.
ADMIN_TOKEN=
# Optional separate read-only RSVP key. Empty disables RSVP submissions.
# Generate at least 32 random characters and never expose it to the invitation.
RSVP_VIEW_TOKEN=
MAX_RSVP_COUNT=5000
RSVP_RATE_PER_HOUR=20
# Set to 1 only behind exactly one trusted reverse proxy that replaces X-Forwarded-For.
TRUST_PROXY_HOPS=0
WEDDING_PORT=5080
WEDDING_UID=10001
WEDDING_GID=10001
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_PIXELS=40000000
MAX_PHOTO_COUNT=5000
MAX_STORAGE_BYTES=10737418240
MIN_FREE_DISK_BYTES=536870912
MAX_GUESTBOOK_COUNT=5000
GUESTBOOK_RATE_PER_HOUR=20
PHOTO_RATE_PER_HOUR=60
DELETE_RATE_PER_TEN_MINUTES=10
